DB_NAME = "bizwise.db"
ASI_API_KEY = os.getenv("ASI_API_KEY") or os.getenv("ASI1_API_KEY")
ASI_BASE_URL = os.getenv("ASI1_BASE_URL", "https://api.asi1.ai/v1")
